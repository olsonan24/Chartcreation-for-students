{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/pattern-ledger.schema.json",
  "title": "Aionis Pattern Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledgerId", "userScopeId", "organizationScopeId", "version", "patterns", "createdAt"],
  "properties": {
    "ledgerId": {"type": "string", "minLength": 1},
    "userScopeId": {"type": "string", "minLength": 1},
    "organizationScopeId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["patternId", "status", "statement", "evidenceIds", "contradictoryEvidenceIds", "confidence", "confidenceDecayRule", "sensitive", "userConfirmed", "version"],
        "properties": {
          "patternId": {"type": "string", "minLength": 1},
          "status": {"enum": ["confirmed-fact", "inferred-pattern", "active-hypothesis", "negative-knowledge", "superseded"]},
          "statement": {"type": "string", "minLength": 1},
          "evidenceIds": {"$ref": "#/$defs/ids"},
          "contradictoryEvidenceIds": {"$ref": "#/$defs/ids"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "confidenceDecayRule": {"type": "string", "minLength": 1},
          "sensitive": {"type": "boolean"},
          "userConfirmed": {"type": "boolean"},
          "version": {"type": "string", "minLength": 1},
          "supersededBy": {"type": ["string", "null"]}
        }
      }
    }
  },
  "$defs": {"ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
