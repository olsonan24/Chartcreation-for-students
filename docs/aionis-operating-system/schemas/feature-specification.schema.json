{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/feature-specification.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Feature Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["featureId", "version", "title", "status", "target", "owner", "problem", "outcome", "inScope", "outOfScope", "acceptanceCriteria", "protectedContracts", "requiredGates", "risks", "failedGateHistory", "approvalInvalidations", "analytics"],
  "properties": {
    "featureId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "target": {"$ref": "#/$defs/target"},
    "owner": {"type": "string", "minLength": 1},
    "problem": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "minLength": 1},
    "inScope": {"$ref": "#/$defs/nonEmptyStrings"},
    "outOfScope": {"$ref": "#/$defs/strings"},
    "acceptanceCriteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "protectedContracts": {"$ref": "#/$defs/strings"},
    "requiredGates": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/gate"}},
    "risks": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["riskId", "summary", "owner"], "properties": {"riskId": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "mitigation": {"type": "string"}}}},
    "failedGateHistory": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gate", "priorState", "returnedToState", "failureReason", "recordedAt"], "properties": {"gate": {"$ref": "#/$defs/gate"}, "priorState": {"$ref": "#/$defs/status"}, "returnedToState": {"$ref": "#/$defs/status"}, "failureReason": {"type": "string", "minLength": 1}, "recordedAt": {"type": "string", "format": "date-time"}}}},
    "approvalInvalidations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["approvalId", "invalidatedAt", "reason"], "properties": {"approvalId": {"type": "string", "minLength": 1}, "invalidatedAt": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}}}},
    "analytics": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["applies", "contractIds"], "properties": {"applies": {"const": true}, "contractIds": {"$ref": "#/$defs/nonEmptyStrings"}}}, {"type": "object", "additionalProperties": false, "required": ["applies", "notApplicableReason"], "properties": {"applies": {"const": false}, "notApplicableReason": {"type": "string", "minLength": 1}}}]},
    "rollbackIdentity": {"type": ["object", "null"], "additionalProperties": false, "required": ["releaseId", "restoreVersion"], "properties": {"releaseId": {"type": "string", "minLength": 1}, "restoreVersion": {"type": "string", "minLength": 1}}},
    "dataClassification": {"type": "array", "uniqueItems": true, "items": {"enum": ["public", "internal", "confidential", "restricted"]}},
    "buildTimeAi": {"type": "boolean"},
    "runtimeAi": {"type": "boolean"},
    "rollbackPlanId": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "ROLLED_BACK"}}, "required": ["status"]}, "then": {"required": ["rollbackIdentity"], "properties": {"rollbackIdentity": {"type": "object"}}}}],
  "$defs": {
    "status": {"enum": ["DRAFT", "PLAN_APPROVED", "BUILDING", "CODE_APPROVED", "STAGED", "RELEASE_APPROVED", "RELEASED", "OBSERVING", "CLOSED", "ROLLED_BACK", "REJECTED"]},
    "target": {"enum": ["DEV_TOOLING", "PUBLIC_STUDENT_APP", "PRIVATE_AIONIS_BACKEND", "PRIVATE_OWNER_CONSOLE", "SHARED_CONTRACT"]},
    "gate": {"enum": ["PLAN_GATE", "CODE_GATE", "RELEASE_GATE", "DREAM_GATE"]},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
