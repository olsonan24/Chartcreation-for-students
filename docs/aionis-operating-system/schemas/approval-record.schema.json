{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/approval-record.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["approvalId", "artifactId", "artifactVersion", "scope", "gate", "approver", "timestamp", "decision", "conditions", "evidenceReferences", "invalidatedAt", "invalidationReason"],
  "properties": {
    "approvalId": {"type": "string", "minLength": 1},
    "artifactId": {"type": "string", "minLength": 1},
    "artifactVersion": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "gate": {"enum": ["PLAN_GATE", "CODE_GATE", "RELEASE_GATE", "DREAM_GATE"]},
    "approver": {"oneOf": [{"type": "object", "additionalProperties": false, "required": ["identity"], "properties": {"identity": {"type": "string", "minLength": 1}}}, {"type": "object", "additionalProperties": false, "required": ["approvedActorReference"], "properties": {"approvedActorReference": {"type": "string", "minLength": 1}}}]},
    "timestamp": {"type": "string", "format": "date-time"},
    "decision": {"enum": ["APPROVED", "REJECTED", "CONDITIONAL"]},
    "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evidenceReferences": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "invalidatedAt": {"type": ["string", "null"], "format": "date-time"},
    "invalidationReason": {"type": ["string", "null"]}
  },
  "allOf": [{"if": {"properties": {"invalidatedAt": {"type": "string"}}, "required": ["invalidatedAt"]}, "then": {"properties": {"invalidationReason": {"type": "string", "minLength": 1}}}}, {"if": {"properties": {"decision": {"const": "CONDITIONAL"}}}, "then": {"properties": {"conditions": {"minItems": 1}}}}]
}
