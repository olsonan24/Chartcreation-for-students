{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/analytics-event.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Analytics Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventName", "schemaVersion", "contractId", "contractVersion", "eventClass", "target", "purposeKey", "occurredAt", "environment", "tenantScope", "payload"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1}, "eventName": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"}, "schemaVersion": {"type": "string", "minLength": 1},
    "contractId": {"type": "string", "minLength": 1}, "contractVersion": {"type": "string", "minLength": 1}, "eventClass": {"enum": ["operational", "product-and-intelligence"]},
    "target": {"enum": ["DEV_TOOLING", "PUBLIC_STUDENT_APP", "PRIVATE_AIONIS_BACKEND", "PRIVATE_OWNER_CONSOLE"]}, "purposeKey": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "occurredAt": {"type": "string", "format": "date-time"}, "environment": {"enum": ["development", "preview", "staging", "production"]}, "tenantScope": {"type": "string", "minLength": 1},
    "payload": {"type": "object"}
  }
}
