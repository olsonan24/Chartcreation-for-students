{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/release-manifest.schema.json",
  "title": "Aionis Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["releaseId", "version", "status", "target", "environment", "commit", "artifactDigest", "featureSpecificationIds", "contractVersions", "verificationEvidenceIds", "securityReviewId", "intelligenceReviewId", "approvalIds", "rolloutStrategy", "rollbackPlanId", "analyticsContractIds", "createdAt"],
  "properties": {
    "releaseId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "verified", "approved", "releasing", "released", "rolled-back", "rejected"]},
    "target": {"enum": ["DEV_TOOLING", "PUBLIC_STUDENT_APP", "PRIVATE_AIONIS_BACKEND", "PRIVATE_OWNER_CONSOLE", "SHARED_CONTRACT"]},
    "environment": {"enum": ["development", "preview", "staging", "production"]},
    "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{7,64}$"},
    "artifactDigest": {"type": "string", "minLength": 1},
    "featureSpecificationIds": {"$ref": "#/$defs/nonEmptyIds"},
    "contractVersions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "intelligenceVersion": {"type": ["string", "null"]},
    "verificationEvidenceIds": {"$ref": "#/$defs/nonEmptyIds"},
    "securityReviewId": {"type": "string", "minLength": 1},
    "intelligenceReviewId": {"type": "string", "minLength": 1},
    "approvalIds": {"$ref": "#/$defs/nonEmptyIds"},
    "migrationIds": {"$ref": "#/$defs/ids"},
    "rolloutStrategy": {"type": "string", "minLength": 1},
    "rollbackPlanId": {"type": "string", "minLength": 1},
    "analyticsContractIds": {"$ref": "#/$defs/ids"},
    "createdAt": {"type": "string", "format": "date-time"},
    "releasedAt": {"type": ["string", "null"], "format": "date-time"},
    "supersedes": {"type": ["string", "null"]}
  },
  "$defs": {
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
