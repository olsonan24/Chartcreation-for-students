{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/operating-system-manifest.schema.json",
  "title": "Aionis Operating System Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestId", "version", "status", "constitutionVersion", "documents", "contracts", "capabilities", "updatedAt"],
  "properties": {
    "manifestId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved", "superseded", "retired"]},
    "constitutionVersion": {"type": "string", "minLength": 1},
    "documents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "contracts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "target", "owner", "contractVersion"],
        "properties": {
          "capabilityId": {"type": "string", "minLength": 1},
          "target": {"$ref": "#/$defs/target"},
          "owner": {"type": "string", "minLength": 1},
          "contractVersion": {"type": "string", "minLength": 1}
        }
      }
    },
    "supersedes": {"type": ["string", "null"]},
    "updatedAt": {"type": "string", "format": "date-time"},
    "approvalIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "target": {"enum": ["DEV_TOOLING", "PUBLIC_STUDENT_APP", "PRIVATE_AIONIS_BACKEND", "PRIVATE_OWNER_CONSOLE", "SHARED_CONTRACT"]}
  }
}
