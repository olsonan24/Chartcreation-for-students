{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/generation-manifest.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Generation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["findingId", "timestamp", "provider", "exactModelId", "modelConfiguration", "promptVersion", "constitutionVersion", "calculationEngineVersion", "synthesisEngineVersion", "knowledgeSnapshot", "evidenceIds", "ruleIds", "modifierIds", "languageTier", "confidence", "timeoutMs", "retryCeiling", "tokenBudget", "costBudget", "fallback", "environment", "releaseVersion", "acceptancePolicy"],
  "properties": {
    "findingId": {"type": "string", "minLength": 1}, "timestamp": {"type": "string", "format": "date-time"}, "provider": {"type": "string", "minLength": 1}, "exactModelId": {"type": "string", "minLength": 1}, "modelConfiguration": {"type": "object", "minProperties": 1},
    "promptVersion": {"type": "string", "minLength": 1}, "constitutionVersion": {"type": "string", "minLength": 1}, "calculationEngineVersion": {"type": "string", "minLength": 1}, "synthesisEngineVersion": {"type": "string", "minLength": 1}, "knowledgeSnapshot": {"type": "string", "minLength": 1},
    "evidenceIds": {"$ref": "#/$defs/ids"}, "ruleIds": {"$ref": "#/$defs/ids"}, "modifierIds": {"$ref": "#/$defs/ids"}, "languageTier": {"type": "string", "minLength": 1}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "timeoutMs": {"type": "integer", "minimum": 1}, "retryCeiling": {"type": "integer", "minimum": 0},
    "tokenBudget": {"type": "object", "additionalProperties": false, "required": ["input", "output"], "properties": {"input": {"type": "integer", "minimum": 0}, "output": {"type": "integer", "minimum": 0}}},
    "costBudget": {"type": "object", "additionalProperties": false, "required": ["currency", "maximum"], "properties": {"currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "maximum": {"type": "number", "minimum": 0}}},
    "fallback": {"type": "object", "additionalProperties": false, "required": ["used", "provider", "exactModelId", "disclosure"], "properties": {"used": {"type": "boolean"}, "provider": {"type": ["string", "null"]}, "exactModelId": {"type": ["string", "null"]}, "disclosure": {"type": "string", "minLength": 1}}},
    "environment": {"enum": ["development", "preview", "staging", "production"]}, "releaseVersion": {"type": "string", "minLength": 1},
    "acceptancePolicy": {"type": "object", "additionalProperties": false, "required": ["policyId", "comparisonMethod"], "properties": {"policyId": {"type": "string", "minLength": 1}, "comparisonMethod": {"type": "string", "minLength": 1}}},
    "supersedes": {"type": ["string", "null"]}
  },
  "allOf": [{"if": {"properties": {"fallback": {"properties": {"used": {"const": true}}}}}, "then": {"properties": {"fallback": {"properties": {"provider": {"type": "string", "minLength": 1}, "exactModelId": {"type": "string", "minLength": 1}}}}}}],
  "$defs": {"ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
