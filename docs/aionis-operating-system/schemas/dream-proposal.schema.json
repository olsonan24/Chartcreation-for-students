{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/dream-proposal.schema.json",
  "title": "Aionis Dream Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "dreamType", "version", "status", "target", "createdAt", "inputSnapshot", "lastProcessedCursor", "evidenceIds", "before", "after", "reason", "contradictions", "idempotencyKey", "mechanicallySafe", "reversible", "constitutionalImpact", "requiresDreamGate"],
  "properties": {
    "proposalId": {"type": "string", "minLength": 1},
    "dreamType": {"enum": ["development", "human-pattern"]},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "pending-review", "approved", "rejected", "applied", "superseded"]},
    "target": {"enum": ["DEV_TOOLING", "PRIVATE_AIONIS_BACKEND", "SHARED_CONTRACT"]},
    "createdAt": {"type": "string", "format": "date-time"},
    "inputSnapshot": {"type": "string", "minLength": 1},
    "lastProcessedCursor": {"type": "string", "minLength": 1},
    "evidenceIds": {"$ref": "#/$defs/ids"},
    "before": {"type": "string"},
    "after": {"type": "string"},
    "reason": {"type": "string", "minLength": 1},
    "contradictions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "idempotencyKey": {"type": "string", "minLength": 1},
    "mechanicallySafe": {"type": "boolean"},
    "reversible": {"type": "boolean"},
    "constitutionalImpact": {"type": "boolean"},
    "requiresDreamGate": {"type": "boolean"},
    "sensitive": {"type": "boolean"},
    "estimatedCost": {"type": "number", "minimum": 0},
    "approvalId": {"type": ["string", "null"]},
    "rejectionReason": {"type": ["string", "null"]},
    "supersedes": {"type": ["string", "null"]}
  },
  "$defs": {"ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
