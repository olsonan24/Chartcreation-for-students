{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/dream-proposal.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Dream Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "dreamType", "version", "status", "target", "createdAt", "inputSnapshot", "lastProcessedCursor", "evidenceIds", "contradictoryEvidenceIds", "exactProposedChange", "reason", "idempotencyKey", "mechanicallySafe", "reversible", "constitutionalImpact", "requestedApprovalGate", "approvalStatus", "rollbackTarget", "sensitivity", "confidence", "history"],
  "properties": {
    "proposalId": {"type": "string", "minLength": 1}, "dreamType": {"enum": ["development", "human-pattern"]}, "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "pending-review", "approved", "rejected", "applied", "superseded"]},
    "target": {"enum": ["DEV_TOOLING", "PRIVATE_AIONIS_BACKEND", "SHARED_CONTRACT"]}, "createdAt": {"type": "string", "format": "date-time"},
    "inputSnapshot": {"type": "string", "minLength": 1}, "lastProcessedCursor": {"type": "string", "minLength": 1},
    "evidenceIds": {"$ref": "#/$defs/ids"}, "contradictoryEvidenceIds": {"$ref": "#/$defs/ids"},
    "exactProposedChange": {"type": "object", "additionalProperties": false, "required": ["before", "after"], "properties": {"before": {"type": "string"}, "after": {"type": "string"}}},
    "reason": {"type": "string", "minLength": 1}, "idempotencyKey": {"type": "string", "minLength": 1}, "mechanicallySafe": {"type": "boolean"}, "reversible": {"type": "boolean"}, "constitutionalImpact": {"type": "boolean"},
    "requestedApprovalGate": {"enum": ["NONE", "DREAM_GATE"]}, "approvalStatus": {"enum": ["NOT_REQUESTED", "PENDING", "APPROVED", "REJECTED", "INVALIDATED"]},
    "approvalId": {"type": ["string", "null"]},
    "rollbackTarget": {"type": "object", "additionalProperties": false, "required": ["artifactId", "version"], "properties": {"artifactId": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "sensitivity": {"enum": ["low", "medium", "high"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "history": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["event", "recordedAt", "reason"], "properties": {"event": {"enum": ["REJECTED", "SUPERSEDED"]}, "recordedAt": {"type": "string", "format": "date-time"}, "reason": {"type": "string", "minLength": 1}, "relatedProposalId": {"type": ["string", "null"]}}}},
    "estimatedCost": {"type": "number", "minimum": 0}, "supersedes": {"type": ["string", "null"]}
  },
  "allOf": [{"if": {"properties": {"dreamType": {"const": "human-pattern"}}}, "then": {"properties": {"requestedApprovalGate": {"const": "DREAM_GATE"}}}}, {"if": {"properties": {"approvalStatus": {"const": "APPROVED"}}}, "then": {"required": ["approvalId"], "properties": {"approvalId": {"type": "string", "minLength": 1}}}}],
  "$defs": {"ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
}
