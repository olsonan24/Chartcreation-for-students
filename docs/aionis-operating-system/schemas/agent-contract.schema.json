{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/schemas/agent-contract.schema.json",
  "x-contractVersion": "1.0.0",
  "title": "Aionis Agent Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["agentId", "version", "featureId", "artifactVersion", "purpose", "target", "owner", "requiredInputs", "requiredOutputs", "allowedPaths", "prohibitedPaths", "allowedTools", "dependencies", "requiredChecks", "currentGate", "handoffRecipient", "approvalReferences", "mayDeploy", "mayModifyFormulas", "mayModifyConstitutionalMethodology", "mayAccessPrivateUserInformation"],
  "properties": {
    "agentId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "featureId": {"type": "string", "minLength": 1},
    "artifactVersion": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "owner": {"type": "string", "minLength": 1},
    "requiredInputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "requiredOutputs": {"$ref": "#/$defs/nonEmptyStrings"},
    "allowedPaths": {"$ref": "#/$defs/strings"},
    "prohibitedPaths": {"$ref": "#/$defs/strings"},
    "allowedTools": {"$ref": "#/$defs/strings"},
    "dependencies": {"$ref": "#/$defs/strings"},
    "requiredChecks": {"$ref": "#/$defs/nonEmptyStrings"},
    "currentGate": {"$ref": "#/$defs/gate"},
    "handoffRecipient": {"type": "string", "minLength": 1},
    "approvalReferences": {"$ref": "#/$defs/strings"},
    "mayDeploy": {"type": "boolean"},
    "mayModifyFormulas": {"type": "boolean"},
    "mayModifyConstitutionalMethodology": {"type": "boolean"},
    "mayAccessPrivateUserInformation": {"type": "boolean"},
    "integrationContractId": {"type": ["string", "null"]}
  },
  "$defs": {
    "target": {"enum": ["DEV_TOOLING", "PUBLIC_STUDENT_APP", "PRIVATE_AIONIS_BACKEND", "PRIVATE_OWNER_CONSOLE", "SHARED_CONTRACT"]},
    "gate": {"enum": ["NONE", "PLAN_GATE", "CODE_GATE", "RELEASE_GATE", "DREAM_GATE"]},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonEmptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
