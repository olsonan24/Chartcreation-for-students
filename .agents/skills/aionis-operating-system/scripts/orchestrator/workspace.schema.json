{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aionis.local/dev-tooling/orchestrator-workspace.schema.json",
  "title": "Aionis Development Orchestrator Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "feature",
    "implementationPlan",
    "assignments",
    "integrationContracts",
    "approvals",
    "approvalMetadata",
    "handoffs",
    "requiredChecks",
    "gateState",
    "history"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "feature": {"type": "object"},
    "implementationPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "version", "summary", "dependencies", "parallelSafeWith", "fileOwnershipRecord"],
      "properties": {
        "artifactId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
        "parallelSafeWith": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fileOwnershipRecord": {"type": "string", "minLength": 1}
      }
    },
    "evidenceLineageReferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryPath", "evidenceIds", "manifestIds", "componentVersions", "reproductionResultIds", "rollbackPlanIds"],
      "properties": {
        "registryPath": {"type": "string", "minLength": 1},
        "evidenceIds": {"$ref": "#/$defs/strings"},
        "manifestIds": {"$ref": "#/$defs/strings"},
        "componentVersions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/componentVersionReference"}},
        "reproductionResultIds": {"$ref": "#/$defs/strings"},
        "rollbackPlanIds": {"$ref": "#/$defs/strings"}
      }
    },
    "assignments": {"type": "array", "items": {"type": "object"}},
    "integrationContracts": {"type": "array", "items": {"$ref": "#/$defs/integrationContract"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "approvalMetadata": {"type": "array", "items": {"$ref": "#/$defs/approvalMetadata"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}},
    "requiredChecks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "gateState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currentGate", "failedGates"],
      "properties": {
        "currentGate": {"enum": ["NONE", "PLAN_GATE", "CODE_GATE", "RELEASE_GATE", "DREAM_GATE"]},
        "failedGates": {"type": "array", "items": {"$ref": "#/$defs/failedGate"}}
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transitions", "failedTransitions", "handoffs", "approvalInvalidations", "artifactVersions", "rollbacks"],
      "properties": {
        "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
        "failedTransitions": {"type": "array", "items": {"$ref": "#/$defs/failedTransition"}},
        "handoffs": {"type": "array", "items": {"$ref": "#/$defs/historyEvent"}},
        "approvalInvalidations": {"type": "array", "items": {"$ref": "#/$defs/historyEvent"}},
        "artifactVersions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactVersion"}},
        "rollbacks": {"type": "array", "items": {"$ref": "#/$defs/rollback"}}
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "componentVersionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "version"],
      "properties": {
        "componentId": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureId", "type", "requiredArtifactVersion"],
      "properties": {
        "featureId": {"type": "string", "minLength": 1},
        "type": {"enum": ["HARD", "SOFT"]},
        "requiredArtifactVersion": {"type": "string", "minLength": 1}
      }
    },
    "integrationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrationContractId", "participants", "overlapPaths", "integrationOwner", "mergeOrder", "verificationOwner"],
      "properties": {
        "integrationContractId": {"type": "string", "minLength": 1},
        "participants": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "overlapPaths": {"$ref": "#/$defs/strings"},
        "integrationOwner": {"type": "string", "minLength": 1},
        "mergeOrder": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "verificationOwner": {"type": "string", "minLength": 1}
      }
    },
    "approvalMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalId", "expiresAt"],
      "properties": {
        "approvalId": {"type": "string", "minLength": 1},
        "expiresAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoffId", "producer", "consumer", "artifactId", "artifactVersion", "outputReferences", "checksCompleted", "knownRisks", "openQuestions", "acceptanceStatus", "acceptedAt", "rejectionReason", "createdAt"],
      "properties": {
        "handoffId": {"type": "string", "minLength": 1},
        "producer": {"type": "string", "minLength": 1},
        "consumer": {"type": "string", "minLength": 1},
        "artifactId": {"type": "string", "minLength": 1},
        "artifactVersion": {"type": "string", "minLength": 1},
        "outputReferences": {"$ref": "#/$defs/strings"},
        "checksCompleted": {"$ref": "#/$defs/strings"},
        "knownRisks": {"$ref": "#/$defs/strings"},
        "openQuestions": {"$ref": "#/$defs/strings"},
        "acceptanceStatus": {"enum": ["PENDING", "ACCEPTED", "REJECTED", "INVALIDATED"]},
        "acceptedAt": {"type": ["string", "null"], "format": "date-time"},
        "rejectionReason": {"type": ["string", "null"]},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkId", "status", "evidenceReferences"],
      "properties": {
        "checkId": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING", "PASSED", "FAILED", "NOT_APPLICABLE"]},
        "evidenceReferences": {"$ref": "#/$defs/strings"}
      }
    },
    "failedGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "failedAt", "reason", "evidenceReferences", "resolvedAt", "resolutionEvidenceReferences"],
      "properties": {
        "gate": {"enum": ["PLAN_GATE", "CODE_GATE", "RELEASE_GATE", "DREAM_GATE"]},
        "failedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "evidenceReferences": {"$ref": "#/$defs/strings"},
        "resolvedAt": {"type": ["string", "null"], "format": "date-time"},
        "resolutionEvidenceReferences": {"$ref": "#/$defs/strings"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousState", "newState", "timestamp", "actor", "reason", "requiredApproval", "evidenceReferences", "failedGateDetails", "rollbackTarget"],
      "properties": {
        "previousState": {"type": "string", "minLength": 1},
        "newState": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "requiredApproval": {"type": ["string", "null"]},
        "evidenceReferences": {"$ref": "#/$defs/strings"},
        "failedGateDetails": {"type": ["object", "null"]},
        "rollbackTarget": {"type": ["object", "null"]}
      }
    },
    "failedTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousState", "attemptedState", "timestamp", "actor", "reason", "requiredApproval", "evidenceReferences", "failedGateDetails", "rollbackTarget"],
      "properties": {
        "previousState": {"type": "string", "minLength": 1},
        "attemptedState": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "requiredApproval": {"type": ["string", "null"]},
        "evidenceReferences": {"$ref": "#/$defs/strings"},
        "failedGateDetails": {"type": ["object", "null"]},
        "rollbackTarget": {"type": ["object", "null"]}
      }
    },
    "historyEvent": {
      "type": "object",
      "additionalProperties": true,
      "required": ["timestamp", "event"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "event": {"type": "string", "minLength": 1}
      }
    },
    "artifactVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "recordedAt", "reason", "supersedes"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "recordedAt": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1},
        "supersedes": {"type": ["string", "null"]}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "actor", "releaseId", "restoreVersion", "reason"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "actor": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "restoreVersion": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
